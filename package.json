{
  "name": "auto-identity-remove",
  "version": "1.0.0",
  "description": "Automated data broker opt-out runner — removes your personal info from 30+ people-search and data broker sites on a monthly schedule",
  "main": "watcher.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node watcher.js",
    "run": "bash run.sh",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.7.2",
    "playwright": "^1.44.0"
  },
  "optionalDependencies": {
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["privacy", "data-broker", "opt-out", "gdpr", "ccpa", "automation", "playwright"],
  "license": "MIT"
}
