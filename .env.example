# Environment variables for auto-identity-remove
# Copy to .env and fill in your values

# CapSolver API key (optional)
# Get it from https://capsolver.com
CAPSOLVER_API_KEY=

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Enable JSON log output (for log aggregation)
LOG_JSON=false

# Playwright browser timeout (ms)
PLAYWRIGHT_TIMEOUT=15000

# Max concurrent browser contexts (for parallel processing)
# MAX_CONCURRENT=1
